# Copy to .env.local. Everything here is baked into the build at `vite build` time.
# No secret belongs in this file: a browser extension ships its bundle to every user.

# Attendo (Firebase): web API key và project ID, lấy trong mobile/lib/firebase_options.dart (mục web).
# Để trống VITE_ATTENDO_API_KEY thì tắt nguồn Attendo.
VITE_ATTENDO_API_KEY=
VITE_ATTENDO_PROJECT_ID=attendo-app-2611

# Chỉ cho bản build test luồng (e2e_web/test_extension.py): Firebase Emulator trên máy, localhost hoặc
# 127.0.0.1. Để trống ở bản phát hành.
VITE_ATTENDO_EMULATOR_HOST=

# Comma-separated origins of the versioned synthetic FAP fixture (mock-fap-v2).
VITE_FIXTURE_ORIGINS=https://attendo-app-2611.web.app,http://localhost:4173,http://127.0.0.1:4173

# Google OAuth client ID (type "Web application") whose authorized redirect URI is
# https://<extension-id>.chromiumapp.org/ . Leave empty to disable the Google Sheets source.
VITE_GOOGLE_CLIENT_ID=

# Optional: base64 public key so the unpacked extension keeps a stable ID (needed for the OAuth
# redirect URI). Generate once; never commit the private .pem.
VITE_EXTENSION_PUBLIC_KEY=
