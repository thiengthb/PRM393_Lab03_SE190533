# Chép thành .env (không commit). Dùng tài khoản TEST, không dùng tài khoản cá nhân.
ARTEMIS_BASE_URL=http://127.0.0.1:8000
ARTEMIS_DEVICE=emulator-5554
QA_APP_PACKAGE=vn.edu.fpt.quick_attend
QA_TEST_EMAIL=quickattend.test@gmail.com
QA_TEST_PASSWORD=
QA_EXPECT_QR_SECONDS=12
# Chế độ Emulator (khuyên dùng, xem docs/test-plan.md mục 3). Bỏ trống thì chạy trên Firebase thật.
# Khi bật: QA_TEST_EMAIL=quanm@fe.edu.vn, QA_TEST_PASSWORD=Demo@123 (tài khoản do seed-demo.mjs tạo).
QA_RESEED_CMD=
# Khóa model (Gemini/Claude/GPT-4o) đặt trong cấu hình ARTEMIS, không đặt ở đây.
